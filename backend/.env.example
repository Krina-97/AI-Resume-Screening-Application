# Copy to .env or set in PowerShell before: mvn spring-boot:run
# Use profile "mysql" for persistent local MySQL (not in-memory H2).

SPRING_PROFILES_ACTIVE=mysql

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_resume_screening
DB_USERNAME=root
DB_PASSWORD=root

# Optional
OPENAI_API_KEY=
JWT_SECRET=change-this-32-char-secret-key-123456
