# Copy to backend/.env or set in PowerShell before: mvn spring-boot:run
# Default profile "mysql" uses local MySQL (see database/LOCAL-MYSQL-SETUP.md).
# For file-based H2 instead, set SPRING_PROFILES_ACTIVE=dev

SPRING_PROFILES_ACTIVE=mysql

# --- MySQL (default) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_resume_screening
DB_USERNAME=root
DB_PASSWORD=root

# --- AI resume evaluation (match score vs job description) ---
# Option A: Google Gemini (recommended if you have a Gemini API key)
GEMINI_API_KEY=AIzaSyDV4M3G20O36mbTWF_405_e2e5_-4nITEg
GEMINI_ENABLED=true
AI_PROVIDER=gemini

# Option B: OpenAI (leave GEMINI_ENABLED=false or omit Gemini key)
# OPENAI_API_KEY=your-openai-api-key-here
# AI_PROVIDER=openai

# Without either key, the app uses a basic keyword heuristic (less accurate scores).

JWT_SECRET=change-this-32-char-secret-key-123456
